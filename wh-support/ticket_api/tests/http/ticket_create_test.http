### Создать новую заявку с возможностью прикрепления файлов
POST {{host}}/api/ticket/create_v2?employee_id={{employee_id}}
Authorization: Basic {{basicAuth}}
Content-Type: application/json

{
  "category_id": 174,
  "ticket_name": "тестовая заявка на создание доп транса",
  "scenario_order_id": 0,
  "files": {
    "excel": [{
      "file_id": 123,
      "file_type": "application/pdf",
      "file_size": 5284324,
      "file_name": "text"
    }],
    "rules_file": [{
      "file_id": 143,
      "file_type": "application/msword",
      "file_size": 52845324
    }]
  },
  "info_for_create": {
    "responsible_id": {
      "id": 1305064,
      "name": "Луцук Ренат Александрович"
    },
    "excel": [{
      "file_id": 123,
      "file_type": "application/pdf",
      "file_size": 5284324
    }],
    "rules_file": [{
      "file_id": 143,
      "file_type": "application/msword",
      "file_size": 52845324,
      "file_name": "text"
    }],
    "date": "2026-05-01"
  }
}

